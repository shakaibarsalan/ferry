{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry",
  "version": "1.5.0",
  "identifier": "dev.ahkamboh.ferry",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ferry",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 620,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Carry Claude Code chats between accounts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
